# Copy to `.dev.vars` (which wrangler reads in local dev) and fill in.
# Leave everything unset to run entirely on Workers AI — no keys needed.
#
# Each model is named by one `@host/model` spec: the prefix says where it runs,
# the rest is the model id. Switching provider is a one-line edit, and the host
# console header shows the live specs back to you, ready to paste.

# Chat model. Default: @cf/meta/llama-3.3-70b-instruct-fp8-fast, though
# wrangler.jsonc overrides that with @cf/zai-org/glm-4.7-flash, which can
# actually call a tool. Onboarding asks the model to name the conversation and
# count the people in it while still writing a reply, and the small Workers AI
# models are unreliable at that; @openrouter/anthropic/claude-haiku-4.5 is the
# one that gets it right first time, so it is what the line below sets.
#   @cf/...          any Workers AI text model, through the AI binding, no keys.
#                    @cf/moonshotai/kimi-k2.7-code is better but needs a paid
#                    Workers plan ("5035: not available on the Workers Free plan").
#   @openrouter/...  any OpenRouter model; needs OPENROUTER_API_KEY below.
#                    @openrouter/openrouter/free is capped at 50 requests a day
#                    without credits — switch back to @cf/... when it runs out.
#                    With your own Anthropic key added to OpenRouter (BYOK), a
#                    Claude model bills to that key instead of the free tier.
TEXT_MODEL=@openrouter/anthropic/claude-haiku-4.5
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=<your-openrouter-api-key>

# Speech-to-text for conversation calls. Default: @cf/openai/whisper-tiny-en.
#   @cf/openai/whisper-tiny-en      Workers AI whisper. Cheapest, and the only
#                                   hosted option with no WebSocket, so it works
#                                   under the `vite dev` AI proxy. No interim
#                                   text; an utterance lands after ~800ms silence.
#   @cf/deepgram/nova-3             Best quality, live interim text. Needs the
#                                   WebSocket upgrade — has failed mid-session
#                                   with "did not return a WebSocket".
#   @cf/deepgram/flux               Same WebSocket path and caveat as nova-3.
#   @local/openai/whisper-tiny-en   The same whisper model on this machine.
#                                   Offline, no Cloudflare calls. Needs
#                                   `pnpm stt:setup` once, then `pnpm stt:server`
#                                   running alongside `pnpm start`.
# STT_MODEL=@local/openai/whisper-tiny-en
# STT_WHISPER_URL=http://localhost:8080/inference
