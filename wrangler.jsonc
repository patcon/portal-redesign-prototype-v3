{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portal-prototype",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ProjectHub",
        "class_name": "ProjectHub"
      },
      {
        "name": "GroupChat",
        "class_name": "GroupChat"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProjectHub", "GroupChat"]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
