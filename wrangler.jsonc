{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portal-prototype",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    // `/recordings/*` is the Worker's, not the SPA's — it streams call audio
    // out of R2. Deliberately not under `/events/`, which is the client's own
    // route namespace and would stop the app being served.
    "run_worker_first": ["/agents/*", "/recordings/*"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ProjectHub",
        "class_name": "ProjectHub",
      },
      {
        "name": "GroupChat",
        "class_name": "GroupChat",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProjectHub", "GroupChat"],
    },
  ],
  // Speech-to-text provider: nova3 | flux | whisper-local. See src/server/stt/.
  "vars": {
    "MODEL_PROVIDER": "workers-ai",
    "OPENROUTER_MODEL": "",
    "WORKERS_AI_MODEL": "",
    "STT_PROVIDER": "nova3",
    "STT_WHISPER_URL": "",
  },
  // `remote: true` is required: under `vite dev` the default local AI proxy
  // cannot perform a WebSocket upgrade, so Nova 3 / Flux streaming STT fails
  // with "did not return a WebSocket". Remote binds to the real service.
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  // Recorded call audio. Raw PCM segments, a couple of seconds each, assembled
  // into a WAV on the way out. R2 rather than KV: arbitrary size, strongly
  // consistent (KV would serve a stale segment to a live listener), no read
  // charge. Retention is bucket config, not Worker config — see
  // `scripts/provision-r2.sh`.
  "r2_buckets": [
    {
      "binding": "RECORDINGS",
      "bucket_name": "portal-prototype-recordings",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
