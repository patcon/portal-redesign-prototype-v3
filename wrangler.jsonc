{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portal-prototype",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ProjectHub",
        "class_name": "ProjectHub",
      },
      {
        "name": "GroupChat",
        "class_name": "GroupChat",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProjectHub", "GroupChat"],
    },
  ],
  // One `@host/model` spec per task; both default in code, so these stay empty.
  // See src/server/model.ts and src/server/stt/index.ts for the accepted hosts.
  //
  // TEXT_MODEL is set rather than left to the code default because the default
  // — `@cf/meta/llama-3.3-70b-instruct-fp8-fast` — is a poor tool caller: given
  // "we're a group of 5" it called `setParticipantCount` on all five steps and
  // never wrote a word, so the turn reached the browser empty. GLM is the model
  // the Agents SDK chat docs use in their own example.
  "vars": {
    "TEXT_MODEL": "@cf/zai-org/glm-4.7-flash",
    "STT_MODEL": "",
    "STT_WHISPER_URL": "",
  },
  // `remote: true` is required by the streaming transcribers: under `vite dev`
  // the default local AI proxy cannot perform a WebSocket upgrade, so Nova 3 /
  // Flux fails with "did not return a WebSocket". Remote binds to the real
  // service. `@cf/openai/whisper-tiny-en` is a plain request and needs none of
  // this, so a whisper-only setup could drop it.
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "observability": {
    "enabled": true,
  },
}
